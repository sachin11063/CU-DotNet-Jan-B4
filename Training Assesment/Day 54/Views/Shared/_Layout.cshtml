<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CompanyPortal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <style>
        * { scroll-behavior: smooth; }

        body { padding-top: 70px; background-color: #f8f9fa; }

        .navbar-brand { font-weight: 700; font-size: 1.4rem; letter-spacing: 1px; }
        .navbar { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .nav-link { transition: color 0.3s ease; }
        .nav-link:hover { color: #ffc107 !important; }

        /* Navbar slide-in */
        .navbar { animation: slideDown 0.6s ease forwards; }
        @@keyframes slideDown {
            from { transform: translateY(-100%); opacity: 0; }
            to   { transform: translateY(0);    opacity: 1; }
        }

        /* Card hover lift */
        .card {
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }
        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.15) !important;
        }

        /* Button hover */
        .btn {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.18);
        }

        /* Image zoom on hover */
        .img-zoom { overflow: hidden; border-radius: 0.375rem; }
        .img-zoom img { transition: transform 0.5s ease; }
        .img-zoom img:hover { transform: scale(1.07); }

        /* Card image zoom */
        .card .card-img-top { transition: transform 0.5s ease; }
        .card:hover .card-img-top { transform: scale(1.06); }
        .card { overflow: hidden; }

        /* Hero text animations */
        .hero-title {
            animation: fadeSlideUp 0.9s ease both;
        }
        .hero-subtitle {
            animation: fadeSlideUp 1.1s ease both;
        }
        .hero-btns {
            animation: fadeSlideUp 1.3s ease both;
        }
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Counter pop */
        .stat-number {
            animation: popIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
        }
        @@keyframes popIn {
            from { opacity: 0; transform: scale(0.5); }
            to   { opacity: 1; transform: scale(1); }
        }

        /* Badge hover */
        .badge { transition: transform 0.2s ease; }
        .badge:hover { transform: scale(1.15); }

        /* List group hover */
        .list-group-item {
            transition: background-color 0.25s ease, padding-left 0.25s ease;
        }
        .list-group-item:hover {
            padding-left: 1.4rem;
            background-color: #f0f4ff;
        }

        /* Table row hover */
        .table tbody tr {
            transition: background-color 0.2s ease, transform 0.2s ease;
        }
        .table tbody tr:hover {
            background-color: #eef2ff !important;
            transform: scale(1.005);
        }

        /* Input focus glow */
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 0.25rem rgba(13,110,253,0.2);
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }

        /* Page hero animation */
        .page-hero {
            animation: heroReveal 0.8s ease both;
        }
        @@keyframes heroReveal {
            from { opacity: 0; transform: translateY(-20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Parallax banner */
        .parallax-banner {
            background-attachment: fixed;
            background-size: cover;
            background-position: center;
        }

        /* Image fade in */
        .img-fluid, .card-img-top {
            animation: imgFadeIn 0.6s ease both;
        }
        @@keyframes imgFadeIn {
            from { opacity: 0; }
            to   { opacity: 1; }
        }

        /* Footer */
        .footer {
            background-color: #212529;
            color: #adb5bd;
            padding: 30px 0;
            margin-top: 60px;
        }
        .footer a {
            color: #ffc107;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        .footer a:hover { color: #fff; }

        /* Icon spin on card hover */
        .card:hover .card-icon {
            animation: spinOnce 0.5s ease;
        }
        @@keyframes spinOnce {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        /* Shimmer divider */
        .animated-divider {
            height: 3px;
            background: linear-gradient(90deg, #0d6efd, #0dcaf0, #0d6efd);
            background-size: 200% auto;
            animation: shimmer 2s linear infinite;
            border-radius: 2px;
            margin: 2rem 0;
        }
        @@keyframes shimmer {
            from { background-position: 0% center; }
            to   { background-position: 200% center; }
        }

        /* Floating animation */
        .floating {
            animation: floating 3s ease-in-out infinite;
        }
        @@keyframes floating {
            0%   { transform: translateY(0px); }
            50%  { transform: translateY(-12px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building floating"></i> CompanyPortal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i> Home</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle"></i> About Us</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear-wide-connected"></i> Services
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" asp-controller="Services" asp-action="Index"><i class="bi bi-list-ul"></i> All Services</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Services" asp-action="Consulting"><i class="bi bi-person-check"></i> Consulting</a></li>
                            <li><a class="dropdown-item" asp-controller="Services" asp-action="Training"><i class="bi bi-mortarboard"></i> Training</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-box-seam"></i> Products
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="bi bi-grid"></i> All Products</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Software"><i class="bi bi-code-slash"></i> Software</a></li>
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Tools"><i class="bi bi-tools"></i> Tools</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Contact" asp-action="Index">
                            <i class="bi bi-envelope"></i> Contact
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3" data-aos="fade-right">
                    <h5 class="text-white"><i class="bi bi-building"></i> CompanyPortal</h5>
                    <p class="small">Delivering excellence in software, consulting, and training since 2010.</p>
                </div>
                <div class="col-md-4 mb-3" data-aos="fade-up">
                    <h6 class="text-white">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Services" asp-action="Index">Services</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Products</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3" data-aos="fade-left">
                    <h6 class="text-white">Contact Info</h6>
                    <p class="small">
                        <i class="bi bi-geo-alt"></i> 123 Tech Park, Silicon Valley<br />
                        <i class="bi bi-telephone"></i> +1 (800) 123-4567<br />
                        <i class="bi bi-envelope"></i> info@companyportal.com
                    </p>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center small mb-0">&copy; @DateTime.Now.Year CompanyPortal. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true,
            offset: 80
        });

        // Animated counters
        function animateCounter(el) {
            const target = parseInt(el.getAttribute('data-target'));
            const suffix = el.getAttribute('data-suffix') || '';
            let count = 0;
            const step = Math.ceil(target / 60);
            const timer = setInterval(() => {
                count += step;
                if (count >= target) { count = target; clearInterval(timer); }
                el.textContent = count + suffix;
            }, 25);
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    animateCounter(e.target);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('[data-target]').forEach(el => observer.observe(el));
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>