@{
    ViewData["Title"] = "Consulting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="page-hero parallax-banner" style="
        background-image: linear-gradient(rgba(13,110,253,0.88), rgba(111,66,193,0.88)),
        url('https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80');
        padding: 80px 0 60px; color: white;">
        <div class="container">
            <h1 class="fw-bold hero-title"><i class="bi bi-person-check"></i> IT Consulting</h1>
            <p class="lead mb-0 hero-subtitle">Strategic technology advice to accelerate your business transformation.</p>
        </div>
    </div>
</div>

<div class="container my-5">

    <div class="row align-items-center g-5 mb-5">
        <div class="col-md-6" data-aos="fade-right">
            <h3 class="fw-bold mb-3">Transform Your Business with Expert Guidance</h3>
            <p class="text-muted">Our certified consultants bring decades of combined experience across industries. We partner with you through every step of your digital journey.</p>
            <p class="text-muted">Whether you're modernizing legacy infrastructure or moving to the cloud, we tailor our approach to fit your unique needs and budget.</p>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-calendar-check"></i> Book a Free Consultation
            </a>
        </div>
        <div class="col-md-6" data-aos="fade-left">
            <div class="img-zoom rounded-4 shadow">
                <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80"
                     class="img-fluid rounded-4" alt="Consulting Team"
                     style="width:100%; height:320px; object-fit:cover;" />
            </div>
        </div>
    </div>

    <div class="animated-divider"></div>

    <h3 class="fw-bold mb-4" data-aos="fade-up"><i class="bi bi-diagram-3 text-primary"></i> Our Consulting Process</h3>
    <div class="accordion shadow-sm mb-5" id="consultingAccordion" data-aos="fade-up">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#step1">
                    <span class="badge bg-primary me-3">Step 1</span> Discovery &amp; Assessment
                </button>
            </h2>
            <div id="step1" class="accordion-collapse collapse show" data-bs-parent="#consultingAccordion">
                <div class="accordion-body text-muted">We begin with a deep-dive assessment of your current IT landscape, business goals, and existing workflows. This phase involves stakeholder interviews, technical audits, and competitive benchmarking.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#step2">
                    <span class="badge bg-info text-dark me-3">Step 2</span> Strategy &amp; Roadmap
                </button>
            </h2>
            <div id="step2" class="accordion-collapse collapse" data-bs-parent="#consultingAccordion">
                <div class="accordion-body text-muted">Our consultants develop a tailored technology roadmap aligned with your business objectives. This includes priority initiatives, resource planning, risk assessment, and ROI projections.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#step3">
                    <span class="badge bg-warning text-dark me-3">Step 3</span> Implementation Support
                </button>
            </h2>
            <div id="step3" class="accordion-collapse collapse" data-bs-parent="#consultingAccordion">
                <div class="accordion-body text-muted">We work side-by-side with your teams during implementation, providing technical guidance, change management support, vendor negotiations, and quality assurance.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#step4">
                    <span class="badge bg-success me-3">Step 4</span> Review &amp; Optimization
                </button>
            </h2>
            <div id="step4" class="accordion-collapse collapse" data-bs-parent="#consultingAccordion">
                <div class="accordion-body text-muted">Post-implementation, we conduct performance reviews and fine-tune systems for optimal efficiency. We provide ongoing advisory support to help you adapt to changing needs.</div>
            </div>
        </div>
    </div>

    <div class="animated-divider"></div>

    <h3 class="fw-bold mb-4" data-aos="fade-up"><i class="bi bi-grid text-primary"></i> Consulting Areas</h3>
    <div class="row g-4">
        <div class="col-md-4" data-aos="zoom-in" data-aos-delay="0">
            <div class="card h-100 shadow-sm border-0">
                <div class="img-zoom"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&q=80" class="card-img-top" style="height:180px; object-fit:cover;" /></div>
                <div class="card-header bg-primary text-white fw-semibold"><i class="bi bi-cloud"></i> Cloud Consulting</div>
                <div class="card-body"><p class="card-text text-muted">AWS, Azure, and GCP migration strategies with cost optimization and security best practices.</p></div>
                <div class="card-footer bg-transparent"><span class="badge bg-primary">AWS</span> <span class="badge bg-info text-dark">Azure</span> <span class="badge bg-danger">GCP</span></div>
            </div>
        </div>
        <div class="col-md-4" data-aos="zoom-in" data-aos-delay="150">
            <div class="card h-100 shadow-sm border-0">
                <div class="img-zoom"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&q=80" class="card-img-top" style="height:180px; object-fit:cover;" /></div>
                <div class="card-header bg-success text-white fw-semibold"><i class="bi bi-shield-lock"></i> Cybersecurity Consulting</div>
                <div class="card-body"><p class="card-text text-muted">Risk assessments, compliance audits (ISO 27001, SOC 2), and security architecture design.</p></div>
                <div class="card-footer bg-transparent"><span class="badge bg-success">ISO 27001</span> <span class="badge bg-secondary">SOC 2</span></div>
            </div>
        </div>
        <div class="col-md-4" data-aos="zoom-in" data-aos-delay="300">
            <div class="card h-100 shadow-sm border-0">
                <div class="img-zoom"><img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&q=80" class="card-img-top" style="height:180px; object-fit:cover;" /></div>
                <div class="card-header bg-warning text-dark fw-semibold"><i class="bi bi-graph-up"></i> Digital Transformation</div>
                <div class="card-body"><p class="card-text text-muted">Modernize legacy systems, automate processes, and unlock data-driven decision making.</p></div>
                <div class="card-footer bg-transparent"><span class="badge bg-warning text-dark">Automation</span> <span class="badge bg-dark">AI/ML</span></div>
            </div>
        </div>
    </div>
</div>