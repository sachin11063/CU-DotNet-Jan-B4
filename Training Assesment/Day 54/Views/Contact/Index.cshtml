@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="page-hero parallax-banner" style="
        background-image: linear-gradient(rgba(33,37,41,0.92), rgba(73,80,87,0.92)),
        url('https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1600&q=80');
        padding: 80px 0 50px; color: white;">
        <div class="container">
            <h1 class="fw-bold hero-title"><i class="bi bi-envelope"></i> Contact Us</h1>
            <p class="lead mb-0 hero-subtitle">We'd love to hear from you. Fill out the form and we'll get back to you shortly.</p>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-5">

        <div class="col-md-7" data-aos="fade-right">
            <div class="card border-0 shadow-sm p-4">
                <h4 class="fw-bold mb-4"><i class="bi bi-send text-primary"></i> Send Us a Message</h4>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control" placeholder="e.g. John Smith" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" placeholder="you@example.com" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                        <input type="tel" class="form-control" placeholder="+1 (800) 000-0000" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Company / Organization</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                        <input type="text" class="form-control" placeholder="Your Company Name" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Area of Interest <span class="text-danger">*</span></label>
                    <select class="form-select">
                        <option value="">-- Select a topic --</option>
                        <option>IT Consulting</option>
                        <option>Training Programs</option>
                        <option>Software Products</option>
                        <option>Developer Tools</option>
                        <option>Partnership</option>
                        <option>General Inquiry</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Message <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="5" placeholder="Describe your project or how we can help you..."></textarea>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="agreeCheck" />
                        <label class="form-check-label text-muted small" for="agreeCheck">
                            I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                        </label>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex">
                    <button type="button" class="btn btn-primary btn-lg flex-grow-1">
                        <i class="bi bi-send"></i> Send Message
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-lg"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-5" data-aos="fade-left">
            <h4 class="fw-bold mb-4"><i class="bi bi-geo-alt text-danger"></i> Find Us</h4>

            <div class="card border-0 shadow-sm mb-3" data-aos="zoom-in" data-aos-delay="0">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-geo-alt-fill text-danger fs-2 card-icon"></i>
                    <div><h6 class="fw-bold mb-1">Office Address</h6><p class="text-muted mb-0 small">123 Tech Park Avenue,<br />Silicon Valley, CA 94025, USA</p></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3" data-aos="zoom-in" data-aos-delay="100">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-telephone-fill text-success fs-2 card-icon"></i>
                    <div><h6 class="fw-bold mb-1">Phone</h6><p class="text-muted mb-0 small">+1 (800) 123-4567<br />Mon–Fri, 9 AM – 6 PM EST</p></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3" data-aos="zoom-in" data-aos-delay="200">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-envelope-fill text-primary fs-2 card-icon"></i>
                    <div><h6 class="fw-bold mb-1">Email</h6><p class="text-muted mb-0 small">info@companyportal.com<br />support@companyportal.com</p></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4" data-aos="zoom-in" data-aos-delay="300">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-headset text-warning fs-2 card-icon"></i>
                    <div><h6 class="fw-bold mb-1">Support Hours</h6><p class="text-muted mb-0 small">24/7 for Enterprise clients<br />Business hours for others</p></div>
                </div>
            </div>

            <h6 class="fw-bold mb-3" data-aos="fade-up">Follow Us</h6>
            <div class="d-flex gap-2 flex-wrap" data-aos="fade-up" data-aos-delay="100">
                <a href="#" class="btn btn-outline-primary btn-sm"><i class="bi bi-linkedin"></i> LinkedIn</a>
                <a href="#" class="btn btn-outline-dark btn-sm"><i class="bi bi-twitter-x"></i> Twitter</a>
                <a href="#" class="btn btn-outline-danger btn-sm"><i class="bi bi-youtube"></i> YouTube</a>
                <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-github"></i> GitHub</a>
            </div>
        </div>

    </div>
</div>