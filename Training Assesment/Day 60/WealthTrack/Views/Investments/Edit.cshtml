@model WealthTrack.Models.Investment

<h2>Edit Investment</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <label>Ticker Symbol</label>
    <input asp-for="TickerSymbol" class="form-control" />

    <label>Asset Name</label>
    <input asp-for="AssetName" class="form-control" />

    <label>Purchase Price</label>
    <input asp-for="PurchasePrice" class="form-control" />

    <label>Quantity</label>
    <input asp-for="Quantity" class="form-control" />

    <label>Purchase Date</label>
    <input asp-for="PurchaseDate" type="date" class="form-control" />

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
</form>