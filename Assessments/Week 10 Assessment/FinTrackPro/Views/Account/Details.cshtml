@model Account

<h2>Account Details</h2>

<div>
    <dl class="row">

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            Balance
        </dt>

        <dd class="col-sm-10">
            @Model.Balance
        </dd>

    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>